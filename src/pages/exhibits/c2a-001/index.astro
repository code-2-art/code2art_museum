---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { exhibits } from "@/data/museum";

const exhibit = exhibits.find((item) => item.id === "c2a-001") ?? exhibits[0];
---

<SiteLayout title={`${exhibit.title} | code2art museum`}>
  <main class="page-shell">
    <section class="page-heading">
      <div>
        <p class="eyebrow">{exhibit.id} / {exhibit.type}</p>
        <h1>{exhibit.title}</h1>
      </div>
      <p>{exhibit.description}</p>
    </section>
    <section class="simple-list">
      <article class="simple-card">
        <p class="row-meta">Process</p>
        <h2>过程与语境</h2>
        <p>{exhibit.process}</p>
      </article>
      <article class="simple-card">
        <p class="row-meta">Metadata</p>
        <h2>{exhibit.year} / {exhibit.author}</h2>
        <p>工具：{exhibit.tools.join(" / ")}</p>
        <p>贡献者：{exhibit.contributors.join(" / ")}</p>
        <p>许可状态：{exhibit.license}</p>
      </article>
    </section>
  </main>
</SiteLayout>
