---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { exhibits } from "@/data/museum";
---

<SiteLayout title="馆藏 | code2art museum">
  <main class="page-shell">
    <section class="page-heading">
      <div>
        <p class="eyebrow">Collection</p>
        <h1>馆藏</h1>
      </div>
      <p>馆藏保存可独立引用的作品、项目、Prompt、方法和历史条目。展览会从馆藏与投稿作品中组织策展关系，但两者不是同一层级。</p>
    </section>
    <section class="index-list">
      {exhibits.map((exhibit) => (
        <a class="index-row" href={`${exhibit.id}/index.html`}>
          <p class="row-meta">{exhibit.id} / {exhibit.type} / {exhibit.year}</p>
          <h3>{exhibit.title}</h3>
          <p>{exhibit.description}</p>
        </a>
      ))}
    </section>
  </main>
</SiteLayout>
