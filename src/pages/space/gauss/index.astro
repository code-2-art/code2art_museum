---
const title = "Gauss Archive | code2art museum";
const description = "由程序化 3D Gaussian Splats 构成、支持键鼠与触控漫游的 code2art museum 虚拟展厅。";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#080807" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="../../assets/code2art-mark.svg" type="image/svg+xml" />
  </head>
  <body>
    <main class="gauss-museum" data-gauss-museum data-active-zone="atrium" data-ready="false">
      <canvas class="gauss-canvas" data-gauss-canvas aria-label="可漫游的高斯泼溅虚拟展厅"></canvas>

      <div class="loading-screen" data-gauss-loading role="status" aria-live="polite">
        <div class="loading-mark" aria-hidden="true"><span></span><span></span><span></span></div>
        <p data-loading-label>正在初始化高斯渲染器…</p>
      </div>

      <div class="hud" aria-label="展厅控制界面">
        <a class="wordmark" href="../../index.html" aria-label="返回 code2art museum 首页">
          <strong>code2art museum</strong>
          <span>GAUSS ARCHIVE</span>
        </a>

        <div class="desktop-actions">
          <button class="outline-control" type="button" data-auto-tour aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5 10 7-10 7Z" /></svg>
            <span data-auto-tour-label>自动导览</span>
          </button>
          <button class="outline-control" type="button" data-open-help>
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M9.8 9a2.35 2.35 0 0 1 4.45 1.06c0 1.94-2.25 2.05-2.25 3.6M12 17.4h.01" /></svg>
            <span>帮助</span>
          </button>
        </div>

        <button class="mobile-help" type="button" data-open-help aria-label="打开帮助">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M9.8 9a2.35 2.35 0 0 1 4.45 1.06c0 1.94-2.25 2.05-2.25 3.6M12 17.4h.01" /></svg>
        </button>

        <div class="reticle" aria-hidden="true"><span></span></div>

        <div class="desktop-hint">
          <p>WASD 移动 · 鼠标观察</p>
          <span>点击画面进入漫游</span>
        </div>

        <p class="zone-label" data-zone-label aria-live="polite">入口庭院 / Archive Atrium</p>
        <div class="version-panel" aria-label="高斯展厅版本">
          <p class="quality-label" data-quality-label aria-live="polite">高性能 · 60 FPS</p>
          <div class="version-switch" role="group" aria-label="切换渲染版本">
            <button type="button" data-gallery-mode="performance" aria-pressed="true">
              <span>高性能版</span>
              <small>实时漫游</small>
            </button>
            <button type="button" data-gallery-mode="concept" aria-pressed="false">
              <span>概念高质量版</span>
              <small>百万级扫描</small>
            </button>
          </div>
        </div>

        <div class="mobile-controls">
          <p class="mobile-hint">拖动画面观察 · 左侧摇杆移动</p>
          <div class="joystick" data-joystick aria-label="移动摇杆">
            <span class="joystick-arrow is-up" aria-hidden="true"></span>
            <span class="joystick-arrow is-right" aria-hidden="true"></span>
            <span class="joystick-arrow is-down" aria-hidden="true"></span>
            <span class="joystick-arrow is-left" aria-hidden="true"></span>
            <span class="joystick-knob" data-joystick-knob></span>
          </div>
          <div class="mobile-actions">
            <button type="button" data-auto-tour aria-pressed="false" aria-label="切换自动导览">
              <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M5 21c7-8 15 4 22-5" /><circle cx="23" cy="9" r="5" /><path class="fill" d="m21 6 5 3-5 3Z" /></svg>
            </button>
            <button type="button" data-reset-view aria-label="回正视角">
              <svg viewBox="0 0 32 32" aria-hidden="true"><rect x="11" y="7" width="10" height="18" rx="5" /><path d="M16 7V3M7 16H3m4 0-2-2m2 2-2 2m20-2h4m-4 0 2-2m-2 2 2 2" /></svg>
            </button>
          </div>
        </div>
      </div>

      <section class="fallback-panel" aria-live="assertive">
        <p data-fallback-message>当前浏览器或图形设备无法启动高斯展厅。</p>
        <a href="../index.html">进入兼容版 3D 展馆</a>
      </section>

      <dialog class="help-dialog" data-help-dialog aria-labelledby="help-title">
        <form method="dialog">
          <div class="dialog-heading">
            <div>
              <p>GAUSS ARCHIVE</p>
              <h1 id="help-title">如何漫游</h1>
            </div>
            <button type="button" data-close-help aria-label="关闭帮助">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
            </button>
          </div>
          <div class="help-grid">
            <section>
              <h2>桌面</h2>
              <p>点击画面锁定鼠标，使用 WASD 或方向键移动；移动鼠标观察。按 Esc 释放鼠标，T 切换自动导览，H 打开帮助。</p>
            </section>
            <section>
              <h2>移动端</h2>
              <p>拖动画面观察，左侧摇杆移动。右侧路线按钮切换自动导览，鼠标图标让视角回正。</p>
            </section>
          </div>
          <p class="technology-note">高性能版用于流畅漫游；概念高质量版以百万级扫描回波重建空间，并保留缺损、噪点与分层采样质感。两版均由 Spark PackedSplats 在 Three.js 中实时排序和绘制。</p>
        </form>
      </dialog>
    </main>
    <script>
      import "../../../gauss/bootstrap";
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    font-family: Inter, "SF Pro Display", "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
    background: #080807;
  }

  * { box-sizing: border-box; }

  html,
  body {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    overscroll-behavior: none;
    background: #080807;
  }

  button,
  a { -webkit-tap-highlight-color: transparent; }

  button { font: inherit; }

  .gauss-museum {
    position: fixed;
    inset: 0;
    min-width: 280px;
    min-height: 480px;
    isolation: isolate;
    background: #080807;
  }

  .gauss-canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
    cursor: crosshair;
  }

  .gauss-museum[data-pointer-locked="true"] .gauss-canvas { cursor: none; }

  .hud {
    position: absolute;
    inset: 0;
    z-index: 2;
    color: #f0eadf;
    pointer-events: none;
    transition: opacity 320ms ease;
  }

  .gauss-museum:not([data-ready="true"]) .hud { opacity: 0.44; }

  .wordmark {
    position: absolute;
    top: max(30px, env(safe-area-inset-top));
    left: max(30px, env(safe-area-inset-left));
    display: grid;
    gap: 7px;
    color: #f0eadf;
    text-decoration: none;
    pointer-events: auto;
  }

  .wordmark strong {
    font-size: clamp(18px, 1.55vw, 25px);
    font-weight: 450;
    letter-spacing: -0.025em;
  }

  .wordmark span {
    font-size: 11px;
    font-weight: 560;
    letter-spacing: 0.36em;
  }

  .desktop-actions {
    position: absolute;
    top: max(30px, env(safe-area-inset-top));
    right: max(30px, env(safe-area-inset-right));
    display: flex;
    gap: 14px;
    pointer-events: auto;
  }

  .outline-control {
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    gap: 10px;
    padding: 0 20px;
    color: #f0eadf;
    font-size: 14px;
    font-weight: 520;
    letter-spacing: 0.04em;
    background: rgba(8, 8, 7, 0.54);
    border: 1px solid rgba(240, 234, 223, 0.58);
    border-radius: 2px;
    cursor: pointer;
    backdrop-filter: blur(9px);
    transition: color 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .outline-control:hover,
  .outline-control:focus-visible,
  .outline-control.is-active {
    color: #fff;
    background: rgba(240, 90, 60, 0.17);
    border-color: #f05a3c;
    outline: none;
  }

  .outline-control svg,
  .mobile-help svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .reticle {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 42px;
    height: 42px;
    border: 1px solid rgba(240, 234, 223, 0.74);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 20px rgba(240, 234, 223, 0.08);
  }

  .reticle::before,
  .reticle::after,
  .reticle span {
    position: absolute;
    inset: 50% auto auto 50%;
    width: 3px;
    height: 3px;
    content: "";
    background: #f0eadf;
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  .desktop-hint {
    position: absolute;
    bottom: max(31px, env(safe-area-inset-bottom));
    left: max(30px, env(safe-area-inset-left));
    display: grid;
    gap: 4px;
    font-size: 14px;
    line-height: 1.45;
    text-shadow: 0 2px 15px #000;
  }

  .desktop-hint p { margin: 0; font-weight: 530; }
  .desktop-hint span { color: rgba(240, 234, 223, 0.72); }

  .zone-label {
    position: absolute;
    bottom: max(31px, env(safe-area-inset-bottom));
    left: 50%;
    margin: 0;
    color: #f0eadf;
    font-size: clamp(15px, 1.25vw, 20px);
    font-weight: 430;
    letter-spacing: 0.01em;
    text-shadow: 0 2px 18px #000;
    transform: translateX(-50%);
    white-space: nowrap;
  }

  .zone-label::first-letter { color: #f05a3c; }

  .version-panel {
    position: absolute;
    right: max(30px, env(safe-area-inset-right));
    bottom: max(31px, env(safe-area-inset-bottom));
    display: grid;
    justify-items: end;
    gap: 9px;
    pointer-events: auto;
  }

  .quality-label {
    margin: 0;
    color: rgba(240, 234, 223, 0.8);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    text-shadow: 0 2px 15px #000;
  }

  .version-switch {
    display: flex;
    padding: 3px;
    background: rgba(8, 8, 7, 0.66);
    border: 1px solid rgba(240, 234, 223, 0.26);
    border-radius: 3px;
    box-shadow: 0 10px 35px rgba(0, 0, 0, 0.28);
    backdrop-filter: blur(11px);
  }

  .version-switch button {
    display: grid;
    min-width: 112px;
    min-height: 48px;
    align-content: center;
    gap: 2px;
    padding: 6px 13px;
    color: rgba(240, 234, 223, 0.62);
    text-align: left;
    background: transparent;
    border: 0;
    border-radius: 1px;
    cursor: pointer;
    transition: color 180ms ease, background 180ms ease;
  }

  .version-switch button + button { border-left: 1px solid rgba(240, 234, 223, 0.14); }
  .version-switch button span { font-size: 12px; font-weight: 580; letter-spacing: 0.02em; }
  .version-switch button small { font-size: 9px; letter-spacing: 0.08em; opacity: 0.62; }
  .version-switch button:hover,
  .version-switch button:focus-visible { color: #f0eadf; outline: none; }
  .version-switch button.is-active {
    color: #f0eadf;
    background: rgba(240, 90, 60, 0.17);
    box-shadow: inset 0 0 0 1px rgba(240, 90, 60, 0.58);
  }
  .version-switch button:disabled { cursor: wait; opacity: 0.48; }

  .loading-screen {
    position: absolute;
    inset: 0;
    z-index: 5;
    display: grid;
    place-content: center;
    gap: 23px;
    color: rgba(240, 234, 223, 0.78);
    background: #080807;
    transition: opacity 420ms ease, visibility 420ms ease;
  }

  .loading-screen.is-hidden { visibility: hidden; opacity: 0; }
  .loading-screen p { margin: 0; font-size: 13px; letter-spacing: 0.08em; }

  .loading-mark { display: flex; justify-content: center; gap: 8px; }
  .loading-mark span {
    width: 7px;
    height: 7px;
    background: #f05a3c;
    border-radius: 50%;
    animation: loading-splat 1.2s ease-in-out infinite;
  }
  .loading-mark span:nth-child(2) { animation-delay: 120ms; background: #d3b56f; }
  .loading-mark span:nth-child(3) { animation-delay: 240ms; background: #8ecf88; }

  @keyframes loading-splat {
    0%, 100% { opacity: 0.35; transform: scale(0.65); }
    50% { opacity: 1; transform: scale(1.35); }
  }

  .mobile-controls,
  .mobile-help { display: none; }

  .fallback-panel {
    position: absolute;
    z-index: 7;
    top: 50%;
    left: 50%;
    display: none;
    width: min(440px, calc(100% - 40px));
    padding: 28px;
    color: #f0eadf;
    background: rgba(8, 8, 7, 0.94);
    border: 1px solid rgba(240, 90, 60, 0.72);
    transform: translate(-50%, -50%);
  }

  .gauss-museum[data-failed="true"] .fallback-panel { display: block; }
  .gauss-museum[data-failed="true"] .loading-screen { display: none; }
  .fallback-panel p { margin: 0 0 18px; line-height: 1.7; }
  .fallback-panel a { color: #f05a3c; text-underline-offset: 4px; }

  .help-dialog {
    width: min(690px, calc(100% - 36px));
    padding: 0;
    color: #f0eadf;
    background: rgba(13, 13, 11, 0.96);
    border: 1px solid rgba(240, 234, 223, 0.28);
    border-radius: 4px;
    box-shadow: 0 24px 90px rgba(0, 0, 0, 0.68);
    backdrop-filter: blur(22px);
  }

  .help-dialog::backdrop { background: rgba(0, 0, 0, 0.66); backdrop-filter: blur(4px); }
  .help-dialog form { padding: 30px; }
  .dialog-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; }
  .dialog-heading p { margin: 0 0 9px; color: #f05a3c; font-size: 10px; letter-spacing: 0.32em; }
  .dialog-heading h1 { margin: 0; font-size: clamp(26px, 4vw, 42px); font-weight: 450; letter-spacing: -0.035em; }
  .dialog-heading button {
    display: grid;
    width: 46px;
    height: 46px;
    place-items: center;
    color: #f0eadf;
    background: transparent;
    border: 1px solid rgba(240, 234, 223, 0.3);
    border-radius: 50%;
    cursor: pointer;
  }
  .dialog-heading svg { width: 20px; fill: none; stroke: currentColor; stroke-width: 1.5; }
  .help-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; margin-top: 45px; }
  .help-grid h2 { margin: 0 0 10px; color: #d3b56f; font-size: 13px; font-weight: 560; letter-spacing: 0.12em; }
  .help-grid p,
  .technology-note { margin: 0; color: rgba(240, 234, 223, 0.72); font-size: 14px; line-height: 1.85; }
  .technology-note { margin-top: 34px; padding-top: 20px; border-top: 1px solid rgba(240, 234, 223, 0.15); }

  @media (max-width: 720px), (pointer: coarse) {
    .wordmark {
      top: max(25px, env(safe-area-inset-top));
      left: max(24px, env(safe-area-inset-left));
      gap: 5px;
    }
    .wordmark strong { font-size: 19px; }
    .wordmark span { font-size: 9px; letter-spacing: 0.31em; }
    .desktop-actions,
    .desktop-hint { display: none; }
    .mobile-help {
      position: absolute;
      top: max(23px, env(safe-area-inset-top));
      right: max(22px, env(safe-area-inset-right));
      display: grid;
      width: 50px;
      height: 50px;
      place-items: center;
      color: #f0eadf;
      background: rgba(8, 8, 7, 0.4);
      border: 1px solid rgba(240, 234, 223, 0.65);
      border-radius: 50%;
      pointer-events: auto;
      backdrop-filter: blur(8px);
    }
    .reticle { width: 32px; height: 32px; }
    .zone-label {
      bottom: calc(max(25px, env(safe-area-inset-bottom)) + 164px);
      max-width: calc(100% - 44px);
      overflow: hidden;
      font-size: 14px;
      text-overflow: ellipsis;
    }
    .version-panel {
      right: max(22px, env(safe-area-inset-right));
      bottom: max(18px, env(safe-area-inset-bottom));
      gap: 5px;
    }
    .quality-label {
      color: rgba(142, 207, 136, 0.84);
      font-size: 9px;
    }
    .version-switch button {
      min-width: 76px;
      min-height: 42px;
      padding: 5px 8px;
    }
    .version-switch button span { font-size: 10px; }
    .version-switch button small { font-size: 7px; }
    .version-switch button + button { min-width: 94px; }
    .mobile-controls {
      position: absolute;
      inset: auto 0 0;
      display: block;
      height: calc(170px + max(18px, env(safe-area-inset-bottom)));
      pointer-events: none;
    }
    .mobile-hint {
      position: absolute;
      right: 0;
      bottom: calc(max(18px, env(safe-area-inset-bottom)) + 132px);
      left: 0;
      margin: 0 auto;
      color: rgba(240, 234, 223, 0.66);
      font-size: 11px;
      text-align: center;
      transform: translateY(-3px);
    }
    .joystick {
      position: absolute;
      bottom: calc(max(18px, env(safe-area-inset-bottom)) + 27px);
      left: max(22px, env(safe-area-inset-left));
      width: 116px;
      height: 116px;
      border: 1px solid rgba(240, 234, 223, 0.42);
      border-radius: 50%;
      background: rgba(8, 8, 7, 0.34);
      pointer-events: auto;
      touch-action: none;
      backdrop-filter: blur(7px);
    }
    .joystick-knob {
      position: absolute;
      inset: 50% auto auto 50%;
      width: 48px;
      height: 48px;
      margin: -24px 0 0 -24px;
      border: 1px solid rgba(240, 234, 223, 0.24);
      border-radius: 50%;
      background: rgba(240, 234, 223, 0.08);
      transition: transform 45ms linear;
    }
    .joystick-arrow { position: absolute; width: 9px; height: 9px; border-top: 1px solid #f0eadf; border-left: 1px solid #f0eadf; opacity: 0.85; }
    .joystick-arrow.is-up { top: 13px; left: 53px; transform: rotate(45deg); }
    .joystick-arrow.is-right { top: 53px; right: 13px; transform: rotate(135deg); }
    .joystick-arrow.is-down { bottom: 13px; left: 53px; transform: rotate(225deg); }
    .joystick-arrow.is-left { top: 53px; left: 13px; transform: rotate(315deg); }
    .mobile-actions {
      position: absolute;
      right: max(22px, env(safe-area-inset-right));
      bottom: calc(max(18px, env(safe-area-inset-bottom)) + 91px);
      display: flex;
      gap: 12px;
      pointer-events: auto;
    }
    .mobile-actions button {
      display: grid;
      width: 62px;
      height: 62px;
      place-items: center;
      color: #f0eadf;
      background: rgba(8, 8, 7, 0.4);
      border: 1px solid rgba(240, 234, 223, 0.5);
      border-radius: 50%;
      backdrop-filter: blur(7px);
    }
    .mobile-actions button.is-active { color: #f05a3c; border-color: #f05a3c; }
    .mobile-actions svg { width: 34px; height: 34px; fill: none; stroke: currentColor; stroke-width: 1.25; stroke-linecap: round; stroke-linejoin: round; }
    .mobile-actions .fill { fill: currentColor; stroke: none; }
    .help-dialog form { padding: 24px; }
    .help-grid { grid-template-columns: 1fr; gap: 24px; margin-top: 34px; }
  }

  @media (max-height: 610px) and (pointer: coarse) {
    .zone-label { bottom: 116px; }
    .mobile-controls { height: 124px; }
    .joystick { width: 88px; height: 88px; bottom: 22px; }
    .joystick-knob { width: 38px; height: 38px; margin: -19px 0 0 -19px; }
    .joystick-arrow { display: none; }
    .mobile-actions { bottom: 76px; }
    .mobile-hint { display: none; }
    .version-panel { bottom: 10px; }
    .quality-label { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .loading-mark span { animation: none; }
    .hud,
    .loading-screen { transition: none; }
  }
</style>
