---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { demoAccounts, demoSubmissions, profiles } from "@/data/museum";
---

<SiteLayout title="成员 | code2art museum">
  <main class="page-shell">
    <section class="page-heading">
      <div>
        <p class="eyebrow">Members</p>
        <h1>成员</h1>
      </div>
      <p>成员 Profile 记录身份、工具栈、代表工作和与 code2art museum 的关系。</p>
    </section>
    <section class="content-band" aria-labelledby="demo-members-title">
      <div class="section-title">
        <p class="eyebrow">Development accounts</p>
        <h2 id="demo-members-title">十个测试身份</h2>
        <p>固定身份只用于本地开发，不对应真实用户，也不能用于线上登录。</p>
      </div>
      <div class="member-grid">
        {demoAccounts.map((account) => {
          const works = demoSubmissions.filter((work) => work.accountId === account.id);
          return (
            <article class="member-card" id={account.slug}>
              <p class="row-meta">DEMO ACCOUNT / {works.length} 件投稿</p>
              <h2>{account.name}</h2>
              <strong>{account.identity}</strong>
              <p>{account.bio}</p>
              <ul>{works.map((work) => <li><a href={`../works/index.html#${work.id}`}>{work.title}</a></li>)}</ul>
            </article>
          );
        })}
      </div>
    </section>
    <section class="simple-list" id="members">
      {profiles.map((profile) => (
        <article class="simple-card" id={profile.id}>
          <p class="row-meta">{profile.status}</p>
          <h2>{profile.name}</h2>
          <p>{profile.identity}</p>
          <p>{profile.relationToCode2Art}</p>
        </article>
      ))}
    </section>
  </main>
</SiteLayout>
