---
import SiteLayout from "@/layouts/SiteLayout.astro";
import ArchiveExplorer from "@/components/ArchiveExplorer.astro";
import { archiveEntrances, historyNodes } from "@/data/museum";
---

<SiteLayout title="档案 | code2art museum">
  <main class="page-shell">
    <section class="page-heading">
      <div>
        <p class="eyebrow">Archive</p>
        <h1>档案</h1>
      </div>
      <p>档案入口将作品、项目、Prompt / Skill、人物和历史节点组织成可被 Museum Agent 解释的知识空间。</p>
    </section>
    <section class="archive-grid">
      {archiveEntrances.map((item) => (
        <article class="archive-entry">
          <span>{item.meta}</span>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </article>
      ))}
    </section>
    <ArchiveExplorer />
    <section class="content-band" aria-labelledby="history-list-title">
      <div class="section-title">
        <p class="eyebrow">Chronicle evidence</p>
        <h2 id="history-list-title">历史节点</h2>
      </div>
      <div class="index-list compact">
        {historyNodes.slice().reverse().map((item) => (
          <article class="index-row" id={item.id}>
            <p class="row-meta">{item.year} / {item.status} / {item.source}</p>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </section>
  </main>
</SiteLayout>
