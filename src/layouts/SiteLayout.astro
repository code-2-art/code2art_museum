---
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "code2art museum",
  description = "实验编程社区的在线数字博物馆、档案馆与研究平台。"
} = Astro.props;

const currentSegments = Astro.url.pathname.split("/").filter(Boolean);
const currentDepth = currentSegments.length;
const currentPrefix = currentDepth > 0 ? "../".repeat(currentDepth) : "";
const href = (path: string) => {
  const cleanPath = path.replace(/^\/+|\/+$/g, "");
  const isFile = /\.[a-z0-9]+$/i.test(cleanPath);
  return `${currentPrefix}${cleanPath ? (isFile ? cleanPath : `${cleanPath}/index.html`) : "index.html"}`;
};

const nav = [
  { label: "展览", href: href("/exhibitions/") },
  { label: "档案", href: href("/archive/") },
  { label: "研究", href: href("/research/") },
  { label: "成员", href: href("/members/") },
  {
    label: "3D 展馆",
    items: [
      {
        label: "版本 1",
        title: "AI 原生三展厅",
        href: href("/space/")
      },
      {
        label: "版本 2",
        title: "离线 3D 场景",
        href: href("/space/v2/")
      }
    ]
  },
  { label: "参与", href: href("/contribute/") }
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={href("/assets/code2art-mark.svg")} type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand-lockup" href={href("/")} aria-label="code2art museum home">
        <img src={href("/assets/code2art-mark.svg")} alt="" />
        <span>code2art museum</span>
      </a>
      <nav class="primary-nav" aria-label="Primary navigation">
        {nav.map((item) => (
          "items" in item ? (
            <details class="nav-dropdown">
              <summary>
                <span>{item.label}</span>
                <svg viewBox="0 0 12 12" aria-hidden="true">
                  <path d="M3 4.5 6 7.5 9 4.5" />
                </svg>
              </summary>
              <div class="nav-dropdown-menu">
                {item.items.map((child) => (
                  <a href={child.href}>
                    <span>{child.label}</span>
                    <strong>{child.title}</strong>
                  </a>
                ))}
              </div>
            </details>
          ) : (
            <a href={item.href}>{item.label}</a>
          )
        ))}
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <p>Copyright © 实验编程 code2art 2016-2026</p>
    </footer>
  </body>
</html>
