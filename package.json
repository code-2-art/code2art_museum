{
  "name": "code2art-museum",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/normalize-docs-links.mjs",
    "preview": "astro preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run verify:build"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.1",
    "astro": "5.18.2",
    "parse5": "8.0.1",
    "tailwindcss": "4.3.1",
    "typescript": "6.0.3"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "1.0.3",
    "@tailwindcss/oxide-win32-x64-msvc": "4.3.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.8"
  }
}
